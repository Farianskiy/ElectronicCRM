APP_VERSION=0.1.0-beta.1

POSTGRES_IMAGE=postgres:18
POSTGRES_DB=electronic_service_db
POSTGRES_USER=electronic_user
POSTGRES_PASSWORD=replace-with-strong-random-password
POSTGRES_VOLUME_NAME=electroniccrm_postgres_data

JWT_ISSUER=ElectronicService
JWT_AUDIENCE=ElectronicService.Client
JWT_SECRET_KEY=replace-with-random-secret-at-least-64-characters
JWT_EXPIRATION_MINUTES=120

WEB_DOMAIN=crm.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

FRONTEND_ORIGIN=https://crm.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

CATALOG_IMPORT_RETENTION_DAYS=30