# ElectronicCRM v0.1.0-beta.1

APP_VERSION=0.1.0-beta.1

POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_DB=electronic_service_db
POSTGRES_USER=electronic_user
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_PORT=5434
POSTGRES_VOLUME_NAME=backend_postgres_data

JWT_ISSUER=ElectronicService
JWT_AUDIENCE=ElectronicService.Client
JWT_SECRET_KEY=replace-with-random-secret-at-least-32-characters
JWT_EXPIRATION_MINUTES=120

BACKEND_PORT=8080
FRONTEND_PORT=3000

FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

CATALOG_IMPORT_RETENTION_DAYS=30